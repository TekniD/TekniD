# Copy to .env.local and fill in. These are read ONLY by the Next.js server
# (API routes); none of them are sent to the browser.

# Internal Invoice Ninja v5 base URL (no trailing slash, no /api/v1)
INVOICE_NINJA_URL=http://10.1.10.5:8888

# Invoice Ninja > Settings > Account Management > Integrations > API Tokens
INVOICE_NINJA_TOKEN=replace-me

# product_key values of the Invoice Ninja products used for auto line items.
# Their price/description are read from Invoice Ninja at sync time.
STANDARD_LABOR_KEY=LAB-STD
AFTER_HOURS_LABOR_KEY=LAB-AH
TRAVEL_MILEAGE_KEY=TRAVEL-KM

# Display-only unit for the travel field: km or mi
NEXT_PUBLIC_DISTANCE_UNIT=km
